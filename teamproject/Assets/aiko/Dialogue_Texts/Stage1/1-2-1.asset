  paragraphs:
  - TalkerName: ???
    Content: "\u50D5\u304B\u3044?\u50D5\u306F\u30CE\u30FC\u30DE\u30F3\u30FB\u30B6\u30E9\u30A4\u30D5\u3002\n\u3053\u306E\u65BD\u8A2D\u30671\u756A\u5049\u3044\u4EBA\u3060\u3088\u3002\n\u30CE\u30FC\u30DE\u30F3\u3068\u6C17\u8EFD\u306B\u547C\u3093\u3067\u304F\u308C\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u308C\u3068\u3001\u3053\u3053\u306F\u53E4\u3044\u53E4\u3044\u5730\u4E0B\u65BD\u8A2D\u3060\u3088\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u541B\u306F\u4ECA\u3001\u3053\u306E\u65BD\u8A2D\u306B\u9589\u3058\u8FBC\u3081\u3089\u308C\u3066\u3044\u308B\u3093\u3060\u3088\uFF1E"
    Options: []
  - TalkerName: "\u9078\u629E\u80A22"
    Content: 
    Options:
    - optionText: "\u3069\u3046\u3084\u3063\u305F\u3089\u3053\u3053\u304B\u3089\u51FA\u3089\u308C\u308B?"
      Next_Dialogue: {fileID: 0}
    - optionText: "\u3075\u3056\u3051\u308B\u306A\u3002\u3053\u3053\u304B\u3089\u51FA\u305B\u3002"
      Next_Dialogue: {fileID: 0}
  endtext:
    End_Text: {fileID: 0}
