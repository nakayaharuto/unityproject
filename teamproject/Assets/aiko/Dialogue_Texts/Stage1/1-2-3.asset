    Options: []
  - TalkerName: ???
    Content: "\u2026\u3053\u306E\u53CD\u5FDC\u306F\u521D\u3081\u3066\u898B\u308B\u306A\u3041\u3002"
    Options: []
  - TalkerName: ???
    Content: "\u304A\u3063\u3068\u3044\u3051\u306A\u3044\u3001\u81EA\u5DF1\u7D39\u4ECB\u304C\u307E\u3060\u3060\u3063\u305F\u306D\u3002"
    Options: []
  - TalkerName: ???
    Content: "\u50D5\u306F\u30CE\u30FC\u30DE\u30F3\u30FB\u30B6\u30E9\u30A4\u30D5\u3002\n\u3053\u306E\u53E4\u3044\u5730\u4E0B\u65BD\u8A2D\u30A2\u30DD\u30CB\u30E5\u30FC\u30DE\u306E\u7BA1\u7406\u8005\u3060\u3002\n\u30CE\u30FC\u30DE\u30F3\u3068\u6C17\u8EFD\u306B\u547C\u3093\u3067\u306D\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u73FE\u72B6\u3001\u541B\u306F\u3053\u306E\u65BD\u8A2D\u306E\u4E2D\u306B\u9589\u3058\u8FBC\u3081\u3089\u308C\u3066\u3044\u308B\u3093\u3060\u3002"
    Options: []
  - TalkerName: "\u9078\u629E\u80A22"
    Content: 
    Options:
    - optionText: "\u3069\u3046\u3059\u308C\u3070\u826F\u3044?"
      Next_Dialogue: {fileID: 11400000, guid: 7490fb416a41b524ab5407cbcb51bd2b, type: 2}
    - optionText: "\u3055\u3063\u3055\u3068\u3053\u3053\u304B\u3089\u51FA\u305B\u3002"
