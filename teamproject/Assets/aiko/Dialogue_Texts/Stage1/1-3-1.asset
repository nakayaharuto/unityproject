  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u306E\u8A00\u8449\u3092\u5F85\u3063\u3066\u3044\u305F\u3088!"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u5358\u5200\u76F4\u5165\u306B\u8A00\u304A\u3046\u3002\u541B\u306B\u306F\u50D5\u304C\u7528\u610F\u3057\u305F\u8B0E\u3092\u89E3\u3044\u3066\u3082\u3089\u3046\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3046\u5FC3\u914D\u3057\u306A\u304F\u3066\u3044\u3044\u3088\u3002\u4ECA\u56DE\u306F\u512A\u3057\u3081\u306B\u4F5C\u3063\u3066\u3042\u308B\u304B\u3089\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3046\u3044\u3046\u308F\u3051\u3060\u304B\u3089\u9811\u5F35\u3063\u3066\u306D!"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u5FDC\u63F4\u3057\u3066\u3044\u308B\u304B\u3089\u306D!"
    Options: []
  endtext:
