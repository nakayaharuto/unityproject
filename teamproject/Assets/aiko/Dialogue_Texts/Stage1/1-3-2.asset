  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u307E\u3041\u307E\u3041\u3001\u305D\u3046\u6012\u3089\u306A\u3044\u3067\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u307E\u3041\u307E\u3041\u3001\u305D\u3046\u6012\u3089\u305A\u843D\u3061\u7740\u3044\u3066\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u541B\u306B\u306F\u50D5\u304C\u7528\u610F\u3057\u305F\u8B0E\u3092\u89E3\u3044\u3066\u3082\u3089\u3046\u3002\n\u3053\u308C\u306F\u6C7A\u5B9A\u4E8B\u9805\u3060\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u541B\u306B\u62D2\u5426\u6A29\u306F\u306A\u3044\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3046\u3044\u3046\u308F\u3051\u3060\u304B\u3089\u9811\u5F35\u3063\u3066\u306D!"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u5FDC\u63F4\u3057\u3066\u308B\u3088!"
    Options: []
  endtext:
