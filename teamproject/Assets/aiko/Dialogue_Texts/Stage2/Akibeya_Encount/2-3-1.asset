  m_Script: {fileID: 11500000, guid: e6517f3e03e708b4da9f91f94f9dd0a8, type: 3}
  m_Name: 2-3-1
  m_EditorClassIdentifier: 
  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u30EC\u30FC\u30B6\u30FC?\u3042\u3041\u3001\u3042\u306E\u90E8\u5C4B\u306E\u4E8B\u304B\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3042\u308C\u306F\u7D50\u69CB\u7C21\u5358\u3060\u3068\u601D\u3063\u305F\u3093\u3060\u3051\u3069\u306D\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3093\u306A\u3053\u3068\u3088\u308A\u30D2\u30F3\u30C8\u304C\u77E5\u308A\u305F\u3044\u3093\u3060\u3063\u305F\u306D\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u2026\u305D\u3046\u3060\u306D\u2026\u3042\u306E\u30EC\u30FC\u30B6\u30FC\u653E\u5C04\u88C5\u7F6E\u304C\u56DE\u3057\u305F\u308A\u51FA\u6765\u308B\u3063\u3066\u77E5\u3063\u3066\u305F\u304B\u306A?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u308C\u3068\u3001\u5929\u4E95\u306B\u4F55\u3084\u3089\u610F\u5473\u6DF1\u306A\u88C5\u7F6E\u304C\u3042\u3063\u305F\u3067\u3057\u3087?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3042\u308C\u306F\u4E00\u4F53\u4F55\u306B\u4F7F\u3046\u3093\u3060\u308D\u3046\u306D?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u2026\u50D5\u304B\u3089\u8A00\u3048\u308B\u306E\u306F\u3053\u308C\u4F4D\u304B\u306A\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u4ED6\u306B\u805E\u304D\u305F\u3044\u4E8B\u306F\u3042\u308B\u304B\u3044?"
    Options: []
  - TalkerName: "\u9078\u629E\u80A25"
    Content: 
    Options:
    - optionText: "\u77F3\u50CF\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: e6e81f698a4f849418b745262409f3e9, type: 2}
    - optionText: "\u592A\u967D\u3084\u6708\u306E\u30DE\u30FC\u30AF\u7B49\u304C\u63CF\u304B\u308C\u305F\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 4ee8c1d406ada3045b1041bbe15ba6f3, type: 2}
    - optionText: "\u8D64\u3001\u9752\u3001\u9EC4\u306E\u30D6\u30ED\u30C3\u30AF\u304C\u591A\u304F\u4E26\u3093\u3060\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 2d1e580001765e445ab5e7c12668978f, type: 2}
    - optionText: "\u30D6\u30ED\u30C3\u30AF\u3092\u306F\u3081\u8FBC\u3080\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: ae0d2c60306ed5341b290de31678f19e, type: 2}
    - optionText: "\u3082\u3046\u805E\u304D\u305F\u3044\u4E8B\u306F\u306A\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 415f93aaa09a0a64e9b7997de0bcdf5f, type: 2}
  endtext:
    End_Text: {fileID: 0}
