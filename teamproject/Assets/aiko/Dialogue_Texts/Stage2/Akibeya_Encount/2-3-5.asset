  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3042\u3041\u3001\u3042\u306E\u90E8\u5C4B\u306E\u4E8B\u304B\u3044\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3046\u3060\u306D\u3047\u3001\u305D\u306E\u90E8\u5C4B\u306E\u5929\u4E95\u306F\u898B\u305F\u304B\u3044?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3057\u3066\u58C1\u306B\u306F\u30D6\u30ED\u30C3\u30AF\u3092\u306F\u3081\u8FBC\u3081\u305D\u3046\u306A\u7AAA\u307F\u304C\u3042\u3061\u3053\u3061\u306B\u3042\u308B\u3088\u306D?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3053\u306B\u63CF\u304B\u308C\u3066\u3044\u308B\u3082\u306E\u3068\u306F\u3081\u8FBC\u307E\u308C\u305F2\u3064\u306E\u30D6\u30ED\u30C3\u30AF\u9054\u3001\u3053\u308C\u3089\u304C\u610F\u5473\u3059\u308B\u3082\u306E\u306F\u4F55\u3060\u3068\u601D\u3046?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u76EE\u306B\u898B\u3048\u308B\u60C5\u5831\u306E\u5168\u3066\u304C\u89E3\u304F\u305F\u3081\u306E\u30D2\u30F3\u30C8\u306B\u7E4B\u304C\u3063\u3066\u3044\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u3060\u304B\u3089\u3001\u6CE8\u610F\u3057\u3066\u898B\u308B\u3093\u3060\u3088?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u4ED6\u306B\u805E\u304D\u305F\u3044\u4E8B\u306F\u3042\u308B\u304B\u3044?"
    Options: []
  - TalkerName: "\u9078\u629E\u80A25"
    Content: 
    Options:
    - optionText: "\u30EC\u30FC\u30B6\u30FC\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 65d5193b6b769c946b4caf16f9ea039e, type: 2}
    - optionText: "\u77F3\u50CF\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: e6e81f698a4f849418b745262409f3e9, type: 2}
    - optionText: "\u592A\u967D\u3084\u6708\u306E\u30DE\u30FC\u30AF\u7B49\u304C\u63CF\u304B\u308C\u305F\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 4ee8c1d406ada3045b1041bbe15ba6f3, type: 2}
    - optionText: "\u8D64\u3001\u9752\u3001\u9EC4\u306E\u30D6\u30ED\u30C3\u30AF\u304C\u591A\u304F\u4E26\u3093\u3060\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 2d1e580001765e445ab5e7c12668978f, type: 2}
    - optionText: "\u3082\u3046\u805E\u304D\u305F\u3044\u4E8B\u306F\u306A\u3044\u306A\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 415f93aaa09a0a64e9b7997de0bcdf5f, type: 2}
  endtext:
    End_Text: {fileID: 0}
