  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3069\u3046\u3057\u305F\u3093\u3060\u3044?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u307E\u3060\u3053\u306E\u90E8\u5C4B\u306B\u7528\u304C\u3042\u308B\u306E\u304B\u306A?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u2026\u4E00\u5FDC\u8A00\u3063\u3066\u304A\u304F\u3051\u3069\u3001\u3053\u306E\u90E8\u5C4B\u306B\u306F\u4F55\u3082\u7121\u3044\u304B\u3089\u306D\u3002\n\u5206\u304B\u3063\u305F\u304B\u3044?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u541B\u306F\u5148\u3078\u9032\u3093\u3067\u3001\u8B0E\u3092\u89E3\u3044\u3066\u3001\u3053\u306E\u968E\u5C64\u3092\u51FA\u308B\u3002\n\u7C21\u5358\u3060\u308D\u3046?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u308C\u3058\u3083\u3001\u9811\u5F35\u3063\u3066\u306D\u3002"
    Options: []
  endtext:
