  m_Name: 2-3-2
  m_EditorClassIdentifier: 
  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u77F3\u50CF\u304B\u3041\u2026\u3002\u3088\u3057\u3001\u7C21\u5358\u306A\u30D2\u30F3\u30C8\u3092\u6559\u3048\u3066\u3042\u3052\u3088\u3046\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u307E\u305A\u3001\u3042\u306E\u90E8\u5C4B\u306B\u77F3\u50CF\u306F4\u4F53\u3042\u3063\u305F\u3067\u3057\u3087?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3057\u3066\u3001\u540C\u3058\u6570\u306E\u30E2\u30CB\u30BF\u30FC\u304C\u90E8\u5C4B\u306E\u4E2D\u306B\u3042\u308B\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u308C\u3068\u3001\u77F3\u50CF\u306F\u56DE\u3059\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3053\u308C\u4F4D\u8A00\u3048\u3070\u5341\u5206\u304B\u306A?"
    Options: []
  - TalkerName: "\u9078\u629E\u80A22"
    Content: 
    Options:
    - optionText: "\u3088\u304F\u5206\u304B\u3063\u305F\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 045a6f982cd54fc49a2734a0730f7ae8, type: 2}
    - optionText: "\u77F3\u50CF\u306B\u66F8\u304B\u308C\u3066\u3044\u305F\u540D\u524D\u306F\u8AB0\u3060?"
      Next_Dialogue: {fileID: 11400000, guid: 5542d2eba9b9d0444aacb1ffb3badd5f, type: 2}
  endtext:
