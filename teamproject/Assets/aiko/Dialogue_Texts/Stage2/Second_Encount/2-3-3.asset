  m_Script: {fileID: 11500000, guid: e6517f3e03e708b4da9f91f94f9dd0a8, type: 3}
  m_Name: 2-3-3
  m_EditorClassIdentifier: 
  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u592A\u967D\u3001\u6708\u2026\u3042\u3041\u3001\u30C0\u30A4\u30E4\u30EB\u306E\u90E8\u5C4B\u304B\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3046\u3060\u306D\u2026\u30C0\u30A4\u30E4\u30EB\u306E\u4E0A\u306B\u306F\u305D\u308C\u305E\u308C\u7D75\u304C\u5F35\u3089\u308C\u3066\u3044\u308B\u3088\u306D\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u306E\u8FD1\u304F\u306B\u306F\u30E2\u30CB\u30BF\u30FC\u304C\u3042\u3063\u3066\u8272\u3005\u306A\u4E8B\u304C\u66F8\u304B\u308C\u3066\u3044\u308B\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u6587\u7AE0\u3068\u7D75\u3001\u6587\u7AE0\u3068\u6570\u5B57\u3001\u305D\u308C\u3089\u3092\u898B\u6BD4\u3079\u3066\u4F55\u304B\u5171\u901A\u3057\u3066\u3044\u308B\u4E8B\u306F\u7121\u3044\u304B\u306A?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3082\u3057\u898B\u3064\u3051\u3089\u308C\u305F\u306E\u306A\u3089\u3001\u305D\u308C\u304C\u89E3\u304F\u305F\u3081\u306E\u30AB\u30AE\u306B\u306A\u308B\u304B\u3082\u306D\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u50D5\u304C\u6559\u3048\u3089\u308C\u308B\u306E\u306F\u3053\u3053\u307E\u3067\u304B\u306A\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u4ED6\u306B\u805E\u304D\u305F\u3044\u4E8B\u306F\u3042\u308B\u304B\u3044?"
    Options: []
  - TalkerName: "\u9078\u629E\u80A25"
    Content: 
    Options:
    - optionText: "\u30EC\u30FC\u30B6\u30FC\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 0528c6d63f9e2064aa514c317c6932bc, type: 2}
    - optionText: "\u77F3\u50CF\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 3cf21d5d1e78b874db0fe911c3757446, type: 2}
    - optionText: "\u8D64\u3001\u9752\u3001\u9EC4\u306E\u30D6\u30ED\u30C3\u30AF\u304C\u591A\u304F\u4E26\u3093\u3060\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 14fa32156b0528b42a92f68efc6fbd5e, type: 2}
    - optionText: "\u30D6\u30ED\u30C3\u30AF\u3092\u306F\u3081\u8FBC\u3080\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 6d58acb10ab1a78458b61a976ce6308e, type: 2}
    - optionText: "\u7279\u306B\u306F\u306A\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 3050ed503c08f3a43a02182ea58cd490, type: 2}
  endtext:
    End_Text: {fileID: 0}
