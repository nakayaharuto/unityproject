  m_Script: {fileID: 11500000, guid: e6517f3e03e708b4da9f91f94f9dd0a8, type: 3}
  m_Name: 2-3-4
  m_EditorClassIdentifier: 
  paragraphs:
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3042\u30FC\u3001\u3042\u306E\u90E8\u5C4B\u304B\u2026\u3002\u3084\u3063\u3071\u308A\u8A70\u307E\u308B\u3088\u306D\u2026\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u51FA\u6765\u308B\u3060\u3051\u4F1D\u308F\u308B\u3088\u3046\u306B\u52AA\u529B\u306F\u3059\u308B\u3088\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3068\u308A\u3042\u3048\u305A\u3001\u305D\u306E\u90E8\u5C4B\u306B\u3042\u308B\u30E2\u30CB\u30BF\u30FC\u30688\u307F\u305F\u3044\u306A\u5F62\u306E\u7269\u4F53\u304C\u89E3\u304F\u306E\u306B\u5FC5\u8981\u306A\u306E\u306F\u5206\u304B\u308B\u3088\u306D?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u305D\u3057\u305F\u3089\u3001\u30E2\u30CB\u30BF\u30FC\u306E\u6587\u7AE0\u3068\u305D\u306E\u7269\u4F53\u3068\u3092\u898B\u6BD4\u3079\u3066\u307F\u305F\u304B\u3044?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u2026\u3053\u308C\u4EE5\u4E0A\u8A00\u3063\u3066\u3057\u307E\u3046\u3068\u7B54\u3048\u306B\u306A\u3063\u3061\u3083\u3046\u304B\u3089\u30D2\u30F3\u30C8\u306F\u3053\u3053\u3067\u304A\u7D42\u3044\u3002"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u3068\u306B\u304B\u304F\u3001\u9811\u5F35\u3063\u3066\u306D?"
    Options: []
  - TalkerName: "\u30CE\u30FC\u30DE\u30F3"
    Content: "\u4ED6\u306B\u805E\u304D\u305F\u3044\u4E8B\u306F\u3042\u308B\u304B\u3044?"
    Options: []
  - TalkerName: "\u9078\u629E\u80A25"
    Content: 
    Options:
    - optionText: "\u30EC\u30FC\u30B6\u30FC\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 0528c6d63f9e2064aa514c317c6932bc, type: 2}
    - optionText: "\u77F3\u50CF\u306E\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 3cf21d5d1e78b874db0fe911c3757446, type: 2}
    - optionText: "\u592A\u967D\u3084\u6708\u306E\u30DE\u30FC\u30AF\u7B49\u304C\u63CF\u304B\u308C\u305F\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: fdd3a273d601b30489b1dbc01cbe1c00, type: 2}
    - optionText: "\u30D6\u30ED\u30C3\u30AF\u3092\u306F\u3081\u8FBC\u3080\u8B0E\u89E3\u304D\u306E\u30D2\u30F3\u30C8\u304C\u805E\u304D\u305F\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 6d58acb10ab1a78458b61a976ce6308e, type: 2}
    - optionText: "\u4ED6\u306B\u805E\u304D\u305F\u3044\u4E8B\u306F\u306A\u3044\u3002"
      Next_Dialogue: {fileID: 11400000, guid: 3050ed503c08f3a43a02182ea58cd490, type: 2}
  endtext:
    End_Text: {fileID: 0}
